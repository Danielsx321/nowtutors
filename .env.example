# App
NEXT_PUBLIC_APP_URL=
NODE_ENV=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never imported into a Client Component
DATABASE_URL=                      # pooled, for Drizzle
DIRECT_URL=                        # direct, for migrations

# Agora
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_TOKEN_SERVICE_URL=

# LessonSpace
LESSONSPACE_API_KEY=
LESSONSPACE_ORG_ID=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox|live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Email
# Unset RESEND_API_KEY means log-only: every email is printed to the server log, nothing is sent.
RESEND_API_KEY=
# Display form, e.g. NowTutors <hello@nowtutors.com>. Until the domain is verified at Resend,
# onboarding@resend.dev works, and only to the Resend account owner's address.
EMAIL_FROM="NowTutors <noreply@nowtutors.com>"
# Where replies land (the support inbox). Falls back to EMAIL_FROM.
EMAIL_REPLY_TO=

# Ops
# Set to 1 (production only) once nowtutors.com is proven, so nowtutors-brown.vercel.app redirects to it.
LAUNCH_REDIRECT_VERCEL_HOST=
CRON_SECRET=
SENTRY_DSN=                        # server + edge
NEXT_PUBLIC_SENTRY_DSN=            # client (browser cannot read the server-only SENTRY_DSN)
