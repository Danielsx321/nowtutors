# This file is the template for `.env.test`, which points at the disposable
# `nowtutors-test` Supabase project used for local seeding and E2E runs.
# That project is safe to wipe/reset at any time.
#
# IMPORTANT: `db:reset` (or any destructive migration/seed command) must never run
# against the wrong env file. Double-check which `.env*` file is active before
# running destructive commands — never point db:reset at `.env.local` / production.
#
# Copy this file to `.env.test` and fill in the real values. `.env.test` and
# `.env.test.local` are gitignored and must never be committed.

# App
NEXT_PUBLIC_APP_URL=
NODE_ENV=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never imported into a Client Component

# DATABASE_URL — Supabase transaction pooler, port 6543. Used at runtime via Drizzle,
# initialized with { prepare: false } (transaction pooling does not support prepared statements).
DATABASE_URL=

# DIRECT_URL — Supabase session pooler (same pooler host, port 5432, sslmode=require), used for
# migrations. The legacy direct host db.<ref>.supabase.co does not resolve on this org, so
# DIRECT_URL must be the session pooler string, not the legacy direct host.
DIRECT_URL=

# Agora
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_TOKEN_SERVICE_URL=

# LessonSpace
LESSONSPACE_API_KEY=
LESSONSPACE_ORG_ID=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox|live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Email
RESEND_API_KEY=
EMAIL_FROM="NowTutors <noreply@nowtutors.com>"

# Ops
CRON_SECRET=
SENTRY_DSN=                        # server + edge
NEXT_PUBLIC_SENTRY_DSN=            # client (browser cannot read the server-only SENTRY_DSN)
