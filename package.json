{
  "name": "nowtutors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "test:e2e": "playwright test",
    "test:db:test": "node scripts/with-ca-certs.mjs --env-file=.env.test vitest run --config vitest.integration.config.ts",
    "db:generate": "node scripts/with-ca-certs.mjs drizzle-kit generate",
    "db:generate:test": "node scripts/with-ca-certs.mjs drizzle-kit generate --config=drizzle.config.test.ts",
    "db:migrate": "node scripts/with-ca-certs.mjs drizzle-kit migrate",
    "db:migrate:test": "node scripts/with-ca-certs.mjs drizzle-kit migrate --config=drizzle.config.test.ts",
    "db:migrate:prod": "node scripts/with-ca-certs.mjs drizzle-kit migrate --config=drizzle.config.prod.ts",
    "db:reset": "node scripts/with-ca-certs.mjs tsx src/db/reset.ts --env=dev",
    "db:reset:test": "node scripts/with-ca-certs.mjs tsx src/db/reset.ts --env=test",
    "db:seed": "node scripts/with-ca-certs.mjs tsx src/db/seed.ts --env=dev",
    "db:seed:test": "node scripts/with-ca-certs.mjs tsx src/db/seed.ts --env=test",
    "db:seed:prod-settings": "node scripts/with-ca-certs.mjs tsx src/db/seed-prod-settings.ts --env=prod",
    "db:seed:test-users:test": "node scripts/with-ca-certs.mjs tsx src/db/seed-test-users.ts --env=test",
    "db:seed:test-users:prod": "node scripts/with-ca-certs.mjs tsx src/db/seed-test-users.ts --env=prod",
    "db:verify-rls": "node scripts/with-ca-certs.mjs tsx src/db/verify-rls.ts --env=dev",
    "db:verify-rls:test": "node scripts/with-ca-certs.mjs tsx src/db/verify-rls.ts --env=test",
    "db:verify-rls:prod": "node scripts/with-ca-certs.mjs tsx src/db/verify-rls-prod.ts --env=prod",
    "guide:pdf": "tsx scripts/build-tutor-guide-pdf.ts",
    "email:tutor-guide": "node scripts/with-ca-certs.mjs tsx src/db/send-tutor-guide.ts --env=dev",
    "email:tutor-guide:test": "node scripts/with-ca-certs.mjs tsx src/db/send-tutor-guide.ts --env=test",
    "email:tutor-guide:prod": "node scripts/with-ca-certs.mjs tsx src/db/send-tutor-guide.ts --env=prod"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-email/render": "^2.1.1",
    "@sentry/nextjs": "^10.76.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "agora-rtc-sdk-ng": "^4.24.9",
    "agora-token": "^2.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "postgres": "^3.4.5",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.90.0",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
